        margin: 0 0 0.35em;
        font-size: 1.25em;
        line-height: 1.3;
        text-align: center;
        text-transform: uppercase;
    }

    .debriefing-content h3 {
        margin: 1.25em 0 0.45em;
        font-size: 1.15em;
        line-height: 1.3;
        font-weight: 700;
        text-decoration: underline;
    }

    .debriefing-content a {
        color: #0563c1;
        text-decoration: underline;
    }

